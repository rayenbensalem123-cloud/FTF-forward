# expo-router@58 declares @expo/ui as an *optional* peer, and npm's strict
# resolver refuses to pick a version for it (ERESOLVE: expo-router wants
# @expo/ui@^58.0.23, npm proposes 58.0.24 and then calls it a conflict).
# We do not use @expo/ui, so ignore optional peer resolution everywhere:
# local installs and the `npm ci` in .github/workflows/release-android.yml.
legacy-peer-deps=true
