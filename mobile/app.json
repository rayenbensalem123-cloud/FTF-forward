{
  "expo": {
    "name": "Tunisia WNT",
    "slug": "tunisia-wnt",
    "scheme": "tunisiawnt",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C1F3D",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Tunisia WNT adds the national camps you are called up to onto your calendar so you don't miss one."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0C1F3D"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "265d6fc9-0f72-4085-b923-890a50ee0f77"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tn.tunisiawnt.app"
    },
    "android": {
      "package": "tn.tunisiawnt.app",
      "versionCode": 1,
      "backgroundColor": "#0C1F3D",
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C1F3D"
      }
    },
    "icon": "./assets/icon.png"
  }
}
