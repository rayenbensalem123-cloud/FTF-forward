# Copy this file to `.env` and fill in the real values. `.env` is gitignored.
# Expo loads EXPO_PUBLIC_* variables automatically.
#
# These are the SAME two values the website uses (NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY). The anon key is public by design: what a person
# can read or change is decided by their login and the database's row-level security.
# NEVER put the service-role key in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the Next.js server (the website) used for server-side features the
# app cannot do on its own, e.g. parsing a camp program file (/api/camp-schedule/parse).
EXPO_PUBLIC_API_URL=
