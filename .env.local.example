# Copy to .env.local and fill in. `.env.local` is gitignored - never commit real keys.
#
#   cp .env.local.example .env.local
#
# Same Supabase project as mobile/.env.example.

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://PROJECTREF.supabase.co

# Browser anon key (safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server only - never commit, never ship to the client.
# Only /api/admin-reset-password needs it; the app works without it.
SUPABASE_SERVICE_ROLE_KEY=

# Legacy Vercel Blob token (optional). Only /api/image needs it.
BLOB_READ_WRITE_TOKEN=

# Direct Postgres access, only used by `npm run db:apply`.
# Dashboard > Connect > Session pooler.
DATABASE_URL=

# Claude API key, from console.anthropic.com -> API keys. Only
# /api/camp-schedule/parse needs it, to read an uploaded camp programme
# (PDF, Word, image or pasted text) into a structured day-by-day schedule.
# Without it, that endpoint falls back to a much cruder regex parser.
ANTHROPIC_API_KEY=
